{
  "$id": "https://programmable.money/schemas/launch-policy-review-decision.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Structural validation is necessary but not sufficient. Canonical semantic validation requires the exact trusted Git policy record.",
  "$defs": {
    "advisory": {
      "additionalProperties": false,
      "properties": {
        "analyzer": { "$ref": "#/$defs/analyzer" },
        "code": { "enum": ["UNBOUND_EVALUATION", "UNBOUND_OBSERVATION"] },
        "evidenceRefs": { "items": { "$ref": "#/$defs/sha256" }, "maxItems": 64, "type": "array", "uniqueItems": true },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "summary": { "maxLength": 1000, "minLength": 1, "type": "string" }
      },
      "required": ["code", "ruleId", "summary", "evidenceRefs", "analyzer"],
      "type": "object"
    },
    "analyzer": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$", "type": "string" },
        "kind": { "enum": ["deterministic", "human", "llm", "scanner"] }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "checkerOnly": { "const": true },
        "independentAudit": { "const": false },
        "launchAuthorized": { "const": false },
        "publicRoutingAuthorized": { "const": false },
        "realFundsAuthorized": { "const": false }
      },
      "required": ["checkerOnly", "independentAudit", "launchAuthorized", "publicRoutingAuthorized", "realFundsAuthorized"],
      "type": "object"
    },
    "deterministicAnalyzer": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$", "type": "string" },
        "kind": { "const": "deterministic" }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "baseCommit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "baseTree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "gitBlobOid": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "numericRepositoryId": { "const": "1320171831" },
        "path": { "const": "policy/launch-policy.v1.json" },
        "policyId": { "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$", "type": "string" },
        "policyVersion": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
        "profileId": { "enum": ["build", "launch-readiness", "production-launch", "workflow-canary"] },
        "repository": { "const": "0xprogrammable/launch-policy" },
        "schemaVersion": { "const": "programmable.launch-policy-binding.v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["schemaVersion", "repository", "numericRepositoryId", "baseCommit", "baseTree", "path", "gitBlobOid", "policyId", "policyVersion", "profileId", "sha256"],
      "type": "object"
    },
    "enforcement": {
      "additionalProperties": false,
      "properties": {
        "handlerId": { "pattern": "^[a-z0-9][a-z0-9-]{1,79}$", "type": "string" },
        "mode": { "const": "deterministic" },
        "owner": { "enum": ["applicant", "maintainer", "platform"] }
      },
      "required": ["handlerId", "mode", "owner"],
      "type": "object"
    },
    "evaluation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["passed", "violated"] } }, "required": ["state"], "type": "object" },
          "then": { "properties": { "evidenceRefs": { "minItems": 1, "type": "array" } }, "type": "object" }
        }
      ],
      "properties": {
        "analyzer": { "$ref": "#/$defs/deterministicAnalyzer" },
        "evidenceRefs": { "items": { "$ref": "#/$defs/sha256" }, "maxItems": 64, "type": "array", "uniqueItems": true },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "state": { "enum": ["analysis_pending", "passed", "violated"] }
      },
      "required": ["ruleId", "state", "evidenceRefs", "analyzer"],
      "type": "object"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "enforcement": { "$ref": "#/$defs/enforcement" },
        "evidenceRefs": { "items": { "$ref": "#/$defs/sha256" }, "maxItems": 64, "minItems": 1, "type": "array", "uniqueItems": true },
        "requirement": { "maxLength": 500, "minLength": 1, "type": "string" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "severity": { "enum": ["blocker", "required"] }
      },
      "required": ["ruleId", "requirement", "severity", "enforcement", "evidenceRefs"],
      "type": "object"
    },
    "ruleId": { "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$", "type": "string" },
    "sha256": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "applicationId": { "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" },
        "applicationRevision": { "maximum": 1000000, "minimum": 1, "type": "integer" },
        "applicationSha256": { "$ref": "#/$defs/sha256" },
        "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "configurationHash": { "$ref": "#/$defs/sha256" },
        "numericRepositoryId": { "pattern": "^[1-9][0-9]{0,19}$", "type": "string" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "repository": { "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string" },
        "routerProvenanceRequired": { "type": "boolean" },
        "tree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "usesUniswapV4": { "type": "boolean" }
      },
      "required": ["numericRepositoryId", "repository", "commit", "tree", "configurationHash", "usesUniswapV4"],
      "type": "object"
    },
    "trustedPolicy": {
      "additionalProperties": false,
      "properties": {
        "baseCommit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "baseTree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "gitBlobOid": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "numericRepositoryId": { "const": "1320171831" },
        "path": { "const": "policy/launch-policy.v1.json" },
        "policyId": { "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$", "type": "string" },
        "policyVersion": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
        "profileId": { "enum": ["build", "launch-readiness", "production-launch", "workflow-canary"] },
        "repository": { "const": "0xprogrammable/launch-policy" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["repository", "numericRepositoryId", "baseCommit", "baseTree", "path", "gitBlobOid", "policyId", "policyVersion", "profileId", "sha256"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" },
      "then": {
        "oneOf": [
          {
            "properties": {
              "currentPolicyBinding": { "type": "null" },
              "currentSubject": { "properties": { "routerProvenanceRequired": { "type": "boolean" } }, "required": ["routerProvenanceRequired"], "type": "object" },
              "expectedPolicyBinding": { "type": "null" },
              "expectedSubject": { "properties": { "routerProvenanceRequired": { "type": "boolean" } }, "required": ["routerProvenanceRequired"], "type": "object" },
              "outcome": { "type": "null" },
              "status": { "const": "profile_disabled" }
            },
            "type": "object"
          },
          {
            "properties": {
              "currentPolicyBinding": { "allOf": [{ "$ref": "#/$defs/binding" }, { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" }] },
              "currentSubject": { "properties": { "routerProvenanceRequired": { "type": "boolean" } }, "required": ["routerProvenanceRequired"], "type": "object" },
              "expectedPolicyBinding": { "allOf": [{ "$ref": "#/$defs/binding" }, { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" }] },
              "expectedSubject": { "properties": { "routerProvenanceRequired": { "type": "boolean" } }, "required": ["routerProvenanceRequired"], "type": "object" },
              "status": { "not": { "const": "profile_disabled" } }
            },
            "type": "object"
          }
        ]
      },
      "else": {
        "properties": {
          "currentPolicyBinding": { "$ref": "#/$defs/binding" },
          "expectedPolicyBinding": { "$ref": "#/$defs/binding" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "build" } }, "required": ["profileId"], "type": "object" },
      "then": {
        "properties": {
          "currentPolicyBinding": { "properties": { "profileId": { "const": "build" } }, "required": ["profileId"], "type": "object" },
          "expectedPolicyBinding": { "properties": { "profileId": { "const": "build" } }, "required": ["profileId"], "type": "object" },
          "status": { "not": { "const": "profile_disabled" } },
          "trustedPolicy": { "properties": { "profileId": { "const": "build" } }, "required": ["profileId"], "type": "object" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "launch-readiness" } }, "required": ["profileId"], "type": "object" },
      "then": {
        "properties": {
          "currentPolicyBinding": { "properties": { "profileId": { "const": "launch-readiness" } }, "required": ["profileId"], "type": "object" },
          "currentSubject": { "properties": { "applicationId": { "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" }, "applicationRevision": { "maximum": 1000000, "minimum": 1, "type": "integer" }, "applicationSha256": { "$ref": "#/$defs/sha256" }, "packageSha256": { "$ref": "#/$defs/sha256" }, "routerProvenanceRequired": { "type": "boolean" } }, "required": ["applicationId", "applicationRevision", "applicationSha256", "packageSha256", "routerProvenanceRequired"], "type": "object" },
          "expectedPolicyBinding": { "properties": { "profileId": { "const": "launch-readiness" } }, "required": ["profileId"], "type": "object" },
          "expectedSubject": { "properties": { "applicationId": { "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" }, "applicationRevision": { "maximum": 1000000, "minimum": 1, "type": "integer" }, "applicationSha256": { "$ref": "#/$defs/sha256" }, "packageSha256": { "$ref": "#/$defs/sha256" }, "routerProvenanceRequired": { "type": "boolean" } }, "required": ["applicationId", "applicationRevision", "applicationSha256", "packageSha256", "routerProvenanceRequired"], "type": "object" },
          "status": { "not": { "const": "profile_disabled" } },
          "trustedPolicy": { "properties": { "profileId": { "const": "launch-readiness" } }, "required": ["profileId"], "type": "object" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "workflow-canary" } }, "required": ["profileId"], "type": "object" },
      "then": {
        "properties": {
          "currentPolicyBinding": { "properties": { "profileId": { "const": "workflow-canary" } }, "required": ["profileId"], "type": "object" },
          "expectedPolicyBinding": { "properties": { "profileId": { "const": "workflow-canary" } }, "required": ["profileId"], "type": "object" },
          "status": { "not": { "const": "profile_disabled" } },
          "trustedPolicy": { "properties": { "profileId": { "const": "workflow-canary" } }, "required": ["profileId"], "type": "object" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" },
      "then": {
        "properties": {
          "currentPolicyBinding": { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" },
          "expectedPolicyBinding": { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" },
          "status": { "not": { "const": "profile_disabled" } },
          "trustedPolicy": { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"], "type": "object" },
      "then": {
        "properties": {
          "evaluations": {
            "items": { "properties": { "state": { "const": "passed" } }, "required": ["state"], "type": "object" },
            "type": "array"
          },
          "findings": { "maxItems": 0, "type": "array" },
          "outcome": { "enum": ["BUILT_NOT_REVIEWED", "CANARY_WORKFLOW_PASSED", "LAUNCH_READINESS_CHECKED_NOT_AUTHORIZED", "PRODUCTION_REQUIREMENTS_CHECKED_NOT_AUTHORIZED"] },
          "pendingRuleIds": { "maxItems": 0, "type": "array" }
        },
        "type": "object"
      },
      "else": { "properties": { "outcome": { "type": "null" } }, "type": "object" }
    },
    {
      "if": { "properties": { "status": { "const": "changes_requested" } }, "required": ["status"], "type": "object" },
      "then": {
        "properties": {
          "evaluations": {
            "contains": { "properties": { "state": { "const": "violated" } }, "required": ["state"], "type": "object" },
            "minContains": 1,
            "type": "array"
          },
          "findings": { "minItems": 1, "type": "array" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "status": { "const": "analysis_pending" } }, "required": ["status"], "type": "object" },
      "then": {
        "properties": {
          "evaluations": {
            "items": { "properties": { "state": { "enum": ["analysis_pending", "passed"] } }, "required": ["state"], "type": "object" },
            "type": "array"
          },
          "findings": { "maxItems": 0, "type": "array" },
          "pendingRuleIds": { "minItems": 1, "type": "array" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["policy_drift", "profile_disabled", "subject_drift"] } }, "required": ["status"], "type": "object" },
      "then": {
        "properties": {
          "evaluations": { "maxItems": 0, "type": "array" },
          "findings": { "maxItems": 0, "type": "array" },
          "notApplicableRuleIds": { "maxItems": 0, "type": "array" },
          "pendingRuleIds": { "maxItems": 0, "type": "array" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "build" }, "status": { "const": "passed" } }, "required": ["profileId", "status"], "type": "object" },
      "then": { "properties": { "outcome": { "const": "BUILT_NOT_REVIEWED" } }, "type": "object" }
    },
    {
      "if": { "properties": { "profileId": { "const": "launch-readiness" }, "status": { "const": "passed" } }, "required": ["profileId", "status"], "type": "object" },
      "then": { "properties": { "outcome": { "const": "LAUNCH_READINESS_CHECKED_NOT_AUTHORIZED" } }, "type": "object" }
    },
    {
      "if": { "properties": { "profileId": { "const": "production-launch" }, "status": { "const": "passed" } }, "required": ["profileId", "status"], "type": "object" },
      "then": { "properties": { "outcome": { "const": "PRODUCTION_REQUIREMENTS_CHECKED_NOT_AUTHORIZED" } }, "type": "object" }
    },
    {
      "if": { "properties": { "profileId": { "const": "workflow-canary" }, "status": { "const": "passed" } }, "required": ["profileId", "status"], "type": "object" },
      "then": { "properties": { "outcome": { "const": "CANARY_WORKFLOW_PASSED" } }, "type": "object" }
    }
  ],
  "properties": {
    "advisories": { "items": { "$ref": "#/$defs/advisory" }, "maxItems": 384, "type": "array" },
    "authority": { "$ref": "#/$defs/authority" },
    "currentPolicyBinding": {},
    "currentSubject": { "$ref": "#/$defs/subject" },
    "digest": { "$ref": "#/$defs/sha256" },
    "evaluations": { "items": { "$ref": "#/$defs/evaluation" }, "maxItems": 256, "type": "array" },
    "expectedPolicyBinding": {},
    "expectedSubject": { "$ref": "#/$defs/subject" },
    "findings": { "items": { "$ref": "#/$defs/finding" }, "maxItems": 256, "type": "array" },
    "notApplicableRuleIds": { "items": { "$ref": "#/$defs/ruleId" }, "maxItems": 256, "type": "array", "uniqueItems": true },
    "outcome": { "enum": [null, "BUILT_NOT_REVIEWED", "CANARY_WORKFLOW_PASSED", "LAUNCH_READINESS_CHECKED_NOT_AUTHORIZED", "PRODUCTION_REQUIREMENTS_CHECKED_NOT_AUTHORIZED"] },
    "pendingRuleIds": { "items": { "$ref": "#/$defs/ruleId" }, "maxItems": 256, "type": "array", "uniqueItems": true },
    "profileId": { "enum": ["build", "launch-readiness", "production-launch", "workflow-canary"] },
    "schemaVersion": { "const": "programmable.launch-policy-review-decision.v1" },
    "status": { "enum": ["analysis_pending", "changes_requested", "passed", "policy_drift", "profile_disabled", "subject_drift"] },
    "trustedPolicy": { "$ref": "#/$defs/trustedPolicy" }
  },
  "required": ["schemaVersion", "profileId", "trustedPolicy", "expectedPolicyBinding", "currentPolicyBinding", "expectedSubject", "currentSubject", "status", "outcome", "authority", "evaluations", "pendingRuleIds", "notApplicableRuleIds", "findings", "advisories", "digest"],
  "title": "Programmable Launch Policy Review Decision V1",
  "type": "object"
}
