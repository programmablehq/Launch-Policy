{
  "$id": "https://programmable.money/schemas/launch-policy-review-input.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "analyzer": {
      "additionalProperties": false,
      "properties": {
        "id": { "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$", "type": "string" },
        "kind": { "enum": ["deterministic", "human", "llm", "scanner"] }
      },
      "required": ["kind", "id"],
      "type": "object"
    },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "baseCommit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "baseTree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "gitBlobOid": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "numericRepositoryId": { "const": "1320171831" },
        "path": { "const": "policy/launch-policy.v1.json" },
        "policyId": { "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$", "type": "string" },
        "policyVersion": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
        "profileId": { "enum": ["build", "launch-readiness", "production-launch", "workflow-canary"] },
        "repository": { "const": "programmablehq/Launch-Policy" },
        "schemaVersion": { "const": "programmable.launch-policy-binding.v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["schemaVersion", "repository", "numericRepositoryId", "baseCommit", "baseTree", "path", "gitBlobOid", "policyId", "policyVersion", "profileId", "sha256"],
      "type": "object"
    },
    "evaluation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["passed", "violated"] } }, "required": ["state"], "type": "object" },
          "then": { "properties": { "evidenceRefs": { "minItems": 1, "type": "array" } }, "type": "object" }
        }
      ],
      "properties": {
        "analyzer": { "$ref": "#/$defs/analyzer" },
        "evidenceRefs": {
          "items": { "$ref": "#/$defs/sha256" },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "state": { "enum": ["analysis_pending", "passed", "violated"] }
      },
      "required": ["ruleId", "state", "evidenceRefs", "analyzer"],
      "type": "object"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "analyzerId": { "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$", "type": "string" },
        "ruleId": { "$ref": "#/$defs/ruleId" },
        "summary": { "maxLength": 1000, "minLength": 1, "type": "string" }
      },
      "required": ["analyzerId", "ruleId", "summary"],
      "type": "object"
    },
    "ruleId": { "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$", "type": "string" },
    "sha256": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "applicationId": { "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" },
        "applicationRevision": { "maximum": 1000000, "minimum": 1, "type": "integer" },
        "applicationSha256": { "$ref": "#/$defs/sha256" },
        "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "configurationHash": { "$ref": "#/$defs/sha256" },
        "numericRepositoryId": { "pattern": "^[1-9][0-9]{0,19}$", "type": "string" },
        "packageSha256": { "$ref": "#/$defs/sha256" },
        "repository": { "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string" },
        "routerProvenanceRequired": { "type": "boolean" },
        "tree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "usesUniswapV4": { "type": "boolean" }
      },
      "required": ["numericRepositoryId", "repository", "commit", "tree", "configurationHash", "usesUniswapV4"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" },
      "then": { "properties": { "currentSubject": { "properties": { "routerProvenanceRequired": { "type": "boolean" } }, "required": ["routerProvenanceRequired"], "type": "object" }, "expectedPolicyBinding": { "anyOf": [{ "type": "null" }, { "allOf": [{ "$ref": "#/$defs/binding" }, { "properties": { "profileId": { "const": "production-launch" } }, "required": ["profileId"], "type": "object" }] }] }, "expectedSubject": { "properties": { "routerProvenanceRequired": { "type": "boolean" } }, "required": ["routerProvenanceRequired"], "type": "object" } }, "type": "object" },
      "else": { "properties": { "expectedPolicyBinding": { "$ref": "#/$defs/binding" } }, "type": "object" }
    },
    {
      "if": { "properties": { "profileId": { "const": "build" } }, "required": ["profileId"], "type": "object" },
      "then": { "properties": { "expectedPolicyBinding": { "properties": { "profileId": { "const": "build" } }, "required": ["profileId"], "type": "object" } }, "type": "object" }
    },
    {
      "if": { "properties": { "profileId": { "const": "launch-readiness" } }, "required": ["profileId"], "type": "object" },
      "then": {
        "properties": {
          "currentSubject": { "properties": { "applicationId": { "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" }, "applicationRevision": { "maximum": 1000000, "minimum": 1, "type": "integer" }, "applicationSha256": { "$ref": "#/$defs/sha256" }, "packageSha256": { "$ref": "#/$defs/sha256" }, "routerProvenanceRequired": { "type": "boolean" } }, "required": ["applicationId", "applicationRevision", "applicationSha256", "packageSha256", "routerProvenanceRequired"], "type": "object" },
          "expectedPolicyBinding": { "properties": { "profileId": { "const": "launch-readiness" } }, "required": ["profileId"], "type": "object" },
          "expectedSubject": { "properties": { "applicationId": { "maxLength": 80, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "type": "string" }, "applicationRevision": { "maximum": 1000000, "minimum": 1, "type": "integer" }, "applicationSha256": { "$ref": "#/$defs/sha256" }, "packageSha256": { "$ref": "#/$defs/sha256" }, "routerProvenanceRequired": { "type": "boolean" } }, "required": ["applicationId", "applicationRevision", "applicationSha256", "packageSha256", "routerProvenanceRequired"], "type": "object" }
        },
        "type": "object"
      }
    },
    {
      "if": { "properties": { "profileId": { "const": "workflow-canary" } }, "required": ["profileId"], "type": "object" },
      "then": { "properties": { "expectedPolicyBinding": { "properties": { "profileId": { "const": "workflow-canary" } }, "required": ["profileId"], "type": "object" } }, "type": "object" }
    }
  ],
  "properties": {
    "currentSubject": { "$ref": "#/$defs/subject" },
    "evaluations": { "items": { "$ref": "#/$defs/evaluation" }, "maxItems": 256, "type": "array" },
    "expectedPolicyBinding": {},
    "expectedSubject": { "$ref": "#/$defs/subject" },
    "observations": { "items": { "$ref": "#/$defs/observation" }, "maxItems": 128, "type": "array", "uniqueItems": true },
    "profileId": { "enum": ["build", "launch-readiness", "production-launch", "workflow-canary"] },
    "schemaVersion": { "const": "programmable.launch-policy-review-input.v1" }
  },
  "required": ["schemaVersion", "profileId", "expectedPolicyBinding", "expectedSubject", "currentSubject", "evaluations", "observations"],
  "title": "Programmable Launch Policy Review Input V1",
  "type": "object"
}
