      },
      "required": ["kind", "sourceSha256", "sourceUrl", "transactionHash"],
      "type": "object"
    },
    "transactionDeploymentRoot": {
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "provenance": { "$ref": "#/$defs/transactionDeploymentProvenance" },
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "startBlock": { "$ref": "#/$defs/positiveDecimal" }
      },
      "required": ["address", "provenance", "runtimeCodeHash", "startBlock"],
      "type": "object"
    },
    "unbroadcastDeploymentRoot": {
      "additionalProperties": false,
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "provenance": { "type": "null" },
        "runtimeCodeHash": { "$ref": "#/$defs/bytes32" },
        "startBlock": { "type": "null" }
      },
      "required": ["address", "provenance", "runtimeCodeHash", "startBlock"],
      "type": "object"
    }
