        "roots": { "$ref": "#/$defs/completePromotionRoots" }
      },
      "required": ["chainDeploymentDescriptorDigest", "chainDeploymentId", "finalityPolicyDigest", "finalizedBlock", "finalizedEvidenceRef", "foundationSourceCommitment", "roots"],
      "type": "object"
    },
    "completePromotionRoots": {
      "additionalProperties": false,
