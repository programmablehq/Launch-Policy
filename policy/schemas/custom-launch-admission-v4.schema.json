  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "admissionEvidenceAuthority": { "const": "private-custom-launch-api" },
        "agentAdmissionAuthority": { "const": false },
        "backendAuthoritative": { "const": true },
        "businessPolicyPath": { "const": "policy/launch-policy.v1.json" },
        "clientAdmissionAuthority": { "const": false },
        "llmAuthorizationAllowed": { "const": false },
        "platformAdmissionReceiptRequired": { "const": true }
      },
      "required": ["admissionEvidenceAuthority", "agentAdmissionAuthority", "backendAuthoritative", "businessPolicyPath", "clientAdmissionAuthority", "llmAuthorizationAllowed", "platformAdmissionReceiptRequired"],
      "type": "object"
    },
    "chain": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "promotionStatus": { "const": "planned" } },
            "required": ["promotionStatus"]
          },
          "then": {},
          "else": {
            "properties": { "deploymentEvidence": { "$ref": "#/$defs/completePromotionAnchor" } }
          }
        }
      ],
      "properties": {
        "caip2": { "const": "eip155:4663" },
        "chainId": { "const": "4663" },
        "deploymentEvidence": { "$ref": "#/$defs/promotionAnchor" },
        "explorerUrl": { "const": "https://robinhoodchain.blockscout.com" },
        "name": { "const": "Robinhood Chain Mainnet" },
        "promotionStatus": { "enum": ["planned", "canary"] },
        "publicRpcProductionAuthority": { "const": false }
      },
      "required": ["caip2", "chainId", "deploymentEvidence", "explorerUrl", "name", "promotionStatus", "publicRpcProductionAuthority"],
      "type": "object"
    },
    "claims": {
      "additionalProperties": false,
      "properties": {
        "auditClaim": { "const": false },
        "buybacksLive": { "const": false },
        "externalIndexingGuaranteed": { "const": false },
        "feeBehaviorClaim": { "const": false },
        "genericClaimingLive": { "const": false },
        "safetyClaim": { "const": false },
        "universalCompatibilityClaim": { "const": false },
        "universalFeeBehaviorClaim": { "const": false }
      },
      "required": ["auditClaim", "buybacksLive", "externalIndexingGuaranteed", "feeBehaviorClaim", "genericClaimingLive", "safetyClaim", "universalCompatibilityClaim", "universalFeeBehaviorClaim"],
      "type": "object"
    },
    "descriptorVersion": { "const": "1.0.0" },
    "funding": {
      "additionalProperties": false,
      "properties": {
        "advertisedModes": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [{ "const": "none" }, { "const": "wallet-transaction-value" }],
          "type": "array"
        },
        "erc20ModesRequireSeparateProof": { "const": true },
        "unsupportedModesAbsent": { "const": true }
      },
      "required": ["advertisedModes", "erc20ModesRequireSeparateProof", "unsupportedModesAbsent"],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "digestBoundBeforeAuthorization": { "const": true },
        "requiredFields": {
          "items": false,
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            { "const": "name" },
            { "const": "symbol" },
            { "const": "description" },
            { "const": "image" },
            { "const": "websiteUrl" },
            { "const": "xUrl" }
          ],
          "type": "array"
        }
      },
      "required": ["digestBoundBeforeAuthorization", "requiredFields"],
      "type": "object"
    },
    "policySelection": {
      "additionalProperties": false,
      "properties": {
        "authenticatedChainBoundRequestRequired": { "const": true },
        "clientSelectable": { "const": false },
        "productionProfileId": { "const": "robinhood-production-launch" },
        "readinessProfileId": { "const": "robinhood-launch-readiness" },
        "selectedBy": { "const": "api-server-chain-binding" }
      },
      "required": ["authenticatedChainBoundRequestRequired", "clientSelectable", "productionProfileId", "readinessProfileId", "selectedBy"],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
        "allFourteenHookPermissionsStructurallySupported": { "const": true },
        "maximumTargets": { "const": 16 },
        "minimumTargets": { "const": 3 },
        "multiContractGraphSupported": { "const": true },
        "profileId": { "const": "programmable.custom-launch.robinhood-mainnet.v1" },
        "profileRevision": { "const": 1 },
        "profileVersion": { "const": "4.0.0" },
        "projectOwnedHookSupported": { "const": true },
        "projectOwnedTokenSupported": { "const": true }
      },
      "required": ["allFourteenHookPermissionsStructurallySupported", "maximumTargets", "minimumTargets", "multiContractGraphSupported", "profileId", "profileRevision", "profileVersion", "projectOwnedHookSupported", "projectOwnedTokenSupported"],
      "type": "object"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "branch": { "const": "main" },
        "foundationSourceCommitment": { "const": "0xe87f5edc2dc839bd87a26a80cb53f14b021e603a1753d27aae3a02862058d730" },
        "name": { "const": "programmablehq/Launch-Policy" },
        "numericRepositoryId": { "const": "1320171831" },
        "productBranch": { "const": "production" },
        "productRepository": { "const": "programmablehq/PROGRAMMABLE" }
      },
      "required": ["branch", "foundationSourceCommitment", "name", "numericRepositoryId", "productBranch", "productRepository"],
      "type": "object"
    },
    "schemaVersion": { "const": "programmable.custom-launch-admission-descriptor.v4" },
    "staticAdmission": {
      "additionalProperties": false,
      "properties": {
        "hardBlockFindingCodes": {
          "items": { "pattern": "^[A-Z][A-Z0-9_]{2,127}$", "type": "string" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "manualProjectAllowlist": { "const": false },
        "noveltyIsNotARejectionReason": { "const": true },
        "unknownFindingDisposition": { "const": "needs-evidence" }
      },
      "required": ["hardBlockFindingCodes", "manualProjectAllowlist", "noveltyIsNotARejectionReason", "unknownFindingDisposition"],
      "type": "object"
    },
    "transport": {
      "additionalProperties": false,
      "properties": {
        "capabilitiesPath": { "const": "/v4/chains/4663/capabilities" },
        "createPath": { "const": "/v4/chains/4663/custom-launches" },
        "finalizedPath": { "const": "/v4/chains/4663/finalized-custom-launches" },
        "openApiUrl": { "const": "https://programmable.market/openapi/custom-launch-v4.json" },
        "packConfigSchemaUrl": { "const": "https://programmable.market/schemas/custom-launch/v4/pack-config.json" },
        "preflightPath": { "const": "/v4/chains/4663/custom-launches/preflight" },
        "statusPathTemplate": { "const": "/v4/chains/4663/custom-launches/{launchId}" }
      },
      "required": ["capabilitiesPath", "createPath", "finalizedPath", "openApiUrl", "packConfigSchemaUrl", "preflightPath", "statusPathTemplate"],
      "type": "object"
    }
  },
  "required": ["authority", "chain", "claims", "descriptorVersion", "funding", "metadata", "policySelection", "profile", "repository", "schemaVersion", "staticAdmission", "transport"],
  "title": "Programmable Custom Launch V4 Robinhood admission descriptor",
  "type": "object"
}
