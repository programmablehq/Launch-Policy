    "finalizedEvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "path": { "pattern": "^contracts/deployments/(?:evidence/)?[A-Za-z0-9._/-]+\\.json$", "type": "string" },
        "repository": { "const": "https://github.com/programmablehq/PROGRAMMABLE" },
        "sha256": { "$ref": "#/$defs/sha256" }
