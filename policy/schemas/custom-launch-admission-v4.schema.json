    "positiveDecimal": { "pattern": "^[1-9][0-9]*$", "type": "string" },
    "sha256": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" },
    "transactionDeploymentProvenance": {
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "deployment-transaction" },
        "sourceSha256": { "const": "sha256:21964cefbfc24b0ee89e7427acf74d223ce5a50aeb4216a9bac361a6148dea15" },
        "sourceUrl": { "const": "https://raw.githubusercontent.com/Uniswap/contracts/4cfc406c8e34da3ce04e60657a7825075b64fd22/deployments/json/4663.json" },
