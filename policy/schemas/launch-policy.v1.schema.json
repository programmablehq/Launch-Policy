{
  "$defs": {
    "checkerAuthority": {
      "additionalProperties": false,
      "properties": {
        "checkerOnly": { "const": true },
        "independentAudit": { "const": false },
        "launchAuthorized": { "const": false },
        "productionDiscoveryAllowed": { "const": false },
        "publicRoutingAllowed": { "const": false },
        "realUserFundsAllowed": { "const": false }
      },
      "required": ["checkerOnly", "independentAudit", "launchAuthorized", "productionDiscoveryAllowed", "publicRoutingAllowed", "realUserFundsAllowed"],
      "type": "object"
    },
    "disabledAuthority": {
      "additionalProperties": false,
      "properties": {
        "checkerOnly": { "const": false },
        "independentAudit": { "const": false },
        "launchAuthorized": { "const": false },
        "productionDiscoveryAllowed": { "const": false },
        "publicRoutingAllowed": { "const": false },
        "realUserFundsAllowed": { "const": false }
      },
      "required": ["checkerOnly", "independentAudit", "launchAuthorized", "productionDiscoveryAllowed", "publicRoutingAllowed", "realUserFundsAllowed"],
      "type": "object"
    },
    "buildProfile": {
      "additionalProperties": false,
      "properties": {
        "authority": { "$ref": "#/$defs/checkerAuthority" },
        "enabled": { "const": true },
        "id": { "const": "build" },
        "outcome": { "const": "BUILT_NOT_REVIEWED" }
      },
      "required": ["authority", "enabled", "id", "outcome"],
      "type": "object"
    },
    "launchReadinessProfile": {
      "additionalProperties": false,
      "properties": {
        "authority": { "$ref": "#/$defs/checkerAuthority" },
        "enabled": { "const": true },
        "id": { "const": "launch-readiness" },
        "outcome": { "const": "LAUNCH_READINESS_CHECKED_NOT_AUTHORIZED" }
      },
      "required": ["authority", "enabled", "id", "outcome"],
      "type": "object"
    },
    "productionProfile": {
      "additionalProperties": false,
      "properties": {
        "authority": { "$ref": "#/$defs/checkerAuthority" },
        "enabled": { "const": true },
        "id": { "const": "production-launch" },
        "outcome": { "const": "PRODUCTION_REQUIREMENTS_CHECKED_NOT_AUTHORIZED" }
      },
      "required": ["authority", "enabled", "id", "outcome"],
      "type": "object"
    },
    "canaryProfile": {
      "additionalProperties": false,
      "properties": {
        "authority": { "$ref": "#/$defs/checkerAuthority" },
        "enabled": { "const": true },
        "id": { "const": "workflow-canary" },
        "outcome": { "const": "CANARY_WORKFLOW_PASSED" }
      },
      "required": ["authority", "enabled", "id", "outcome"],
      "type": "object"
    },
    "rule": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } }, "required": ["status"] },
          "then": {
            "properties": {
              "applicability": {
                "not": { "properties": { "mode": { "const": "historical" } }, "required": ["mode"], "type": "object" },
                "type": "object"
              },
              "enforcement": {
                "properties": {
                  "handlerId": { "pattern": "^[a-z0-9][a-z0-9-]{1,79}$", "type": "string" },
                  "mode": { "const": "deterministic" }
                },
                "required": ["handlerId", "mode"],
                "type": "object"
              },
              "retiredIn": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "inactive" } }, "required": ["status"] },
          "then": {
            "properties": {
              "retiredIn": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" }
            },
            "oneOf": [
              {
                "properties": {
                  "applicability": {
                    "not": { "properties": { "mode": { "const": "historical" } }, "required": ["mode"], "type": "object" },
                    "type": "object"
                  },
                  "enforcement": {
                    "properties": {
                      "handlerId": { "pattern": "^[a-z0-9][a-z0-9-]{1,79}$", "type": "string" },
                      "mode": { "const": "deterministic" }
                    },
                    "required": ["handlerId", "mode"],
                    "type": "object"
                  }
                }
              },
              {
                "properties": {
                  "applicability": { "properties": { "mode": { "const": "historical" } }, "required": ["mode"], "type": "object" },
                  "enforcement": {
                    "properties": {
                      "handlerId": { "type": "null" },
                      "mode": { "enum": ["human", "legacy-adapter"] }
                    },
                    "required": ["handlerId", "mode"],
                    "type": "object"
                  },
                  "profiles": {
                    "items": false,
                    "maxItems": 1,
                    "minItems": 1,
                    "prefixItems": [{ "const": "production-launch" }],
                    "type": "array"
                  }
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "applicability": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": { "mode": { "enum": ["always", "historical"] } },
              "required": ["mode"],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "equals": { "type": "boolean" },
                "field": { "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$", "type": "string" },
                "mode": { "const": "when" }
              },
              "required": ["equals", "field", "mode"],
              "type": "object"
            }
          ]
        },
        "enforcement": {
          "additionalProperties": false,
          "properties": {
            "handlerId": { "type": ["string", "null"] },
            "mode": { "enum": ["deterministic", "human", "legacy-adapter"] },
            "owner": { "enum": ["applicant", "maintainer", "platform"] }
          },
          "required": ["handlerId", "mode", "owner"],
          "type": "object"
        },
        "evidence": {
          "items": { "pattern": "^[a-z0-9][a-z0-9-]{1,79}$", "type": "string" },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": { "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*)+$", "type": "string" },
        "introducedIn": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
        "parameters": { "type": "object" },
        "profiles": {
          "items": { "enum": ["build", "launch-readiness", "production-launch", "workflow-canary"] },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "requirement": { "maxLength": 500, "minLength": 1, "type": "string" },
        "retiredIn": {
          "anyOf": [
            { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
            { "type": "null" }
          ]
        },
        "severity": { "enum": ["blocker", "required"] },
        "status": { "enum": ["active", "inactive"] }
      },
      "required": ["applicability", "enforcement", "evidence", "id", "introducedIn", "profiles", "requirement", "retiredIn", "severity", "status"],
      "type": "object"
    }
  },
  "$id": "https://programmable.money/schemas/launch-policy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effective": {
      "additionalProperties": false,
      "properties": {
        "startsAt": { "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string" },
        "state": { "const": "current" }
      },
      "required": ["startsAt", "state"],
      "type": "object"
    },
    "migration": {
      "additionalProperties": false,
      "properties": {
        "emergencyAction": { "type": "null" },
        "openApplications": { "const": "re-evaluate-current-policy" },
        "previouslyAcceptedRevisions": { "const": "preserve-unless-explicit-emergency" }
      },
      "required": ["emergencyAction", "openApplications", "previouslyAcceptedRevisions"],
      "type": "object"
    },
    "policyId": { "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$", "type": "string" },
    "policyVersion": { "const": "2.3.0" },
    "profiles": {
      "items": false,
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/buildProfile" },
        { "$ref": "#/$defs/launchReadinessProfile" },
        { "$ref": "#/$defs/productionProfile" },
        { "$ref": "#/$defs/canaryProfile" }
      ],
      "type": "array"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "branch": { "const": "main" },
        "name": { "const": "0xprogrammable/launch-policy" },
        "numericRepositoryId": { "const": "1320171831" },
        "path": { "const": "policy/launch-policy.v1.json" }
      },
      "required": ["branch", "name", "numericRepositoryId", "path"],
      "type": "object"
    },
    "rules": {
      "items": { "$ref": "#/$defs/rule" },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": { "const": "programmable.launch-policy.v1" }
  },
  "required": ["effective", "migration", "policyId", "policyVersion", "profiles", "repository", "rules", "schemaVersion"],
  "title": "Programmable Launch Policy V1",
  "type": "object"
}
