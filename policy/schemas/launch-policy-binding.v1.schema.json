{
  "$id": "https://programmable.money/schemas/launch-policy-binding.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseCommit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "baseTree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "gitBlobOid": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "numericRepositoryId": { "const": "1320171831" },
    "path": { "const": "policy/launch-policy.v1.json" },
    "policyId": { "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$", "type": "string" },
    "policyVersion": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
    "profileId": { "enum": ["build", "launch-readiness", "workflow-canary"] },
    "repository": { "const": "0xprogrammable/launch-policy" },
    "schemaVersion": { "const": "programmable.launch-policy-binding.v1" },
    "sha256": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" }
  },
  "required": [
    "schemaVersion",
    "repository",
    "numericRepositoryId",
    "baseCommit",
    "baseTree",
    "path",
    "gitBlobOid",
    "policyId",
    "policyVersion",
    "profileId",
    "sha256"
  ],
  "title": "Programmable Launch Policy Binding V1",
  "type": "object"
}
