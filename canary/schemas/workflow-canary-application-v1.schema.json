{
  "$id": "https://programmable.money/schemas/workflow-canary-application-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "baseCommit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "baseTree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "gitBlobOid": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "numericRepositoryId": { "const": "1320171831" },
        "path": { "const": "policy/launch-policy.v1.json" },
        "policyId": { "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$", "type": "string" },
        "policyVersion": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
        "profileId": { "const": "workflow-canary" },
        "repository": { "const": "programmablehq/Launch-Policy" },
        "schemaVersion": { "const": "programmable.launch-policy-binding.v1" },
        "sha256": { "pattern": "^sha256:[0-9a-f]{64}$", "type": "string" }
      },
      "required": ["schemaVersion", "repository", "numericRepositoryId", "baseCommit", "baseTree", "path", "gitBlobOid", "policyId", "policyVersion", "profileId", "sha256"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applicationId": { "maxLength": 128, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "type": "string" },
    "applicationRevision": { "maximum": 1000000000, "minimum": 1, "type": "integer" },
    "builder": {
      "additionalProperties": false,
      "properties": {
        "githubLogin": { "maxLength": 39, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$", "type": "string" },
        "githubUserId": { "pattern": "^[1-9][0-9]{0,63}$", "type": "string" }
      },
      "required": ["githubLogin", "githubUserId"],
      "type": "object"
    },
    "declarations": {
      "additionalProperties": false,
      "properties": {
        "hiddenFromPublicRoutingAndDiscovery": { "const": true },
        "independentAudit": { "const": false },
        "productionRouting": { "const": false },
        "realUserFunds": { "const": false }
      },
      "required": ["hiddenFromPublicRoutingAndDiscovery", "independentAudit", "productionRouting", "realUserFunds"],
      "type": "object"
    },
    "expectedPolicyBinding": { "$ref": "#/$defs/binding" },
    "schemaVersion": { "const": "programmable.workflow-canary-application.v1" },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "numericRepositoryId": { "pattern": "^[1-9][0-9]{0,63}$", "type": "string" },
        "repository": { "maxLength": 202, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string" },
        "tree": { "pattern": "^[0-9a-f]{40}$", "type": "string" }
      },
      "required": ["repository", "numericRepositoryId", "commit", "tree"],
      "type": "object"
    },
    "summary": { "maxLength": 1000, "minLength": 1, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069])[\\s\\S]+$", "type": "string" },
    "title": { "maxLength": 120, "minLength": 1, "pattern": "^(?!\\s)(?![\\s\\S]*\\s$)(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069])[\\s\\S]+$", "type": "string" }
  },
  "required": ["schemaVersion", "applicationId", "applicationRevision", "builder", "source", "expectedPolicyBinding", "title", "summary", "declarations"],
  "title": "Programmable Workflow Canary Application V1",
  "type": "object"
}
