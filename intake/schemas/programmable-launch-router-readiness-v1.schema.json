            "components": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "account",
                  "kind",
                  "resultIndex",
                  "runtimeCodeHash",
                  "scope"
                ],
                "properties": {
                  "account": { "$ref": "#/$defs/address" },
                  "kind": { "enum": [0, 1, 2] },
                  "resultIndex": { "minimum": 0, "maximum": 255, "type": "integer" },
                  "runtimeCodeHash": { "$ref": "#/$defs/nonzeroBytes32" },
                  "scope": { "enum": [1, 2] }
                }
              }
            },
            "hashAlgorithm": { "const": "router-v1-typed-hash" },
            "hookRuntimeCodeHash": { "$ref": "#/$defs/nonzeroBytes32" },
            "launchId": { "$ref": "#/$defs/nonzeroBytes32" },
            "poolKey": {
              "type": "object",
              "additionalProperties": false,
              "required": ["currency0", "currency1", "fee", "hooks", "tickSpacing"],
              "properties": {
                "currency0": { "$ref": "#/$defs/address" },
                "currency1": { "$ref": "#/$defs/address" },
                "fee": { "minimum": 0, "maximum": 16777215, "type": "integer" },
                "hooks": { "$ref": "#/$defs/address" },
                "tickSpacing": { "minimum": -8388608, "maximum": 8388607, "type": "integer" }
              }
            },
            "poolKeyHash": { "$ref": "#/$defs/nonzeroBytes32" },
            "stampRequestHash": { "$ref": "#/$defs/nonzeroBytes32" },
            "token": { "$ref": "#/$defs/address" },
            "tokenRuntimeCodeHash": { "$ref": "#/$defs/nonzeroBytes32" },
            "typeHash": { "const": "0xa61627b33bfee8131fa1b566b7787c8d93afc86629f51a5c9719bf8f6b3e5573" },
            "typeSignature": { "const": "ProgrammableStampRequestV1(bytes32 launchId,address token,bytes32 tokenRuntimeCodeHash,bytes32 poolKeyHash,bytes32 hookRuntimeCodeHash,bytes32 componentSetHash)" }
          }
        }
      }
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sourceArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "gitBlobOid",
        "path",
        "sha256"
      ],
      "properties": {
        "byteLength": {
          "minimum": 1,
          "maximum": 16777216,
          "type": "integer"
        },
        "gitBlobOid": { "$ref": "#/$defs/objectId" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "commit",
        "configurationHash",
        "numericRepositoryId",
        "repository",
        "tree"
      ],
      "properties": {
        "artifact": { "$ref": "#/$defs/sourceArtifactBinding" },
        "commit": { "$ref": "#/$defs/objectId" },
        "configurationHash": { "$ref": "#/$defs/sha256" },
        "numericRepositoryId": { "$ref": "#/$defs/numericId" },
        "repository": { "$ref": "#/$defs/repository" },
        "tree": { "$ref": "#/$defs/objectId" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationId",
        "applicationRevision",
        "sourceCommit",
        "sourceConfigurationHash",
        "sourceRepository",
        "sourceRepositoryNumericId",
        "sourceTree"
      ],
      "properties": {
        "applicationId": { "$ref": "#/$defs/slug" },
        "applicationRevision": {
          "minimum": 1,
          "maximum": 1000000,
          "type": "integer"
        },
        "sourceCommit": { "$ref": "#/$defs/objectId" },
        "sourceConfigurationHash": { "$ref": "#/$defs/sha256" },
        "sourceRepository": { "$ref": "#/$defs/repository" },
        "sourceRepositoryNumericId": { "$ref": "#/$defs/numericId" },
        "sourceTree": { "$ref": "#/$defs/objectId" }
      }
    },
    "trustedApplicabilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "commit",
        "declaredRouteMode",
        "declarationKind",
        "gitBlobOid",
        "numericRepositoryId",
        "path",
        "repository",
        "sha256",
        "tree",
        "trustBasis"
      ],
      "properties": {
        "byteLength": {
          "minimum": 1,
          "maximum": 1048576,
          "type": "integer"
        },
        "commit": { "$ref": "#/$defs/objectId" },
        "declaredRouteMode": { "enum": ["no-market", "external-route"] },
        "declarationKind": { "enum": ["trusted-no-market-declaration", "trusted-external-route-declaration"] },
        "gitBlobOid": { "$ref": "#/$defs/objectId" },
        "numericRepositoryId": { "const": "1320171831" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "repository": { "const": "0xprogrammable/launch-policy" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "tree": { "$ref": "#/$defs/objectId" },
        "trustBasis": { "const": "protected-launch-policy-base-content-addressed" }
      },
      "oneOf": [
        {
          "properties": {
            "declaredRouteMode": { "const": "no-market" },
            "declarationKind": { "const": "trusted-no-market-declaration" }
          }
        },
        {
          "properties": {
            "declaredRouteMode": { "const": "external-route" },
            "declarationKind": { "const": "trusted-external-route-declaration" }
          }
        }
      ]
    },
    "canonicalTimestamp": {
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "decimal": {
      "maxLength": 78,
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "numericId": {
      "pattern": "^[1-9][0-9]{0,63}$",
      "type": "string"
    },
    "repository": {
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "type": "string"
    },
    "slug": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    }
  }
}
