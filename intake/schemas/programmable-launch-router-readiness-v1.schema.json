          }
        },
        "numericRepositoryId": {
          "const": "1322379959"
        },
        "repository": {
          "const": "0xprogrammable/developers"
        },
        "routerAbi": {
          "const": {
            "byteLength": 26541,
            "gitBlobOid": "b6e14bd7db9c701bd3b10e65561a985d7fcdb991",
