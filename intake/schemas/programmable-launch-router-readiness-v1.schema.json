{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:programmable:launch-router-readiness:1.0.0",
  "title": "Programmable Launch Router Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "applicability",
    "authority",
    "developerReference",
    "feeConfiguration",
    "kind",
    "manifestSnapshot",
    "resolvedRouter",
    "route",
    "schemaVersion",
    "state",
    "subject"
  ],
  "properties": {
    "$schema": {
      "const": "urn:programmable:launch-router-readiness:1.0.0"
    },
    "applicability": {
      "oneOf": [
        { "$ref": "#/$defs/notApplicableApplicability" },
        { "$ref": "#/$defs/pendingApplicability" },
        { "$ref": "#/$defs/prelaunchApplicability" }
      ]
    },
    "authority": {
      "$ref": "#/$defs/inertAuthority"
    },
    "developerReference": {
      "oneOf": [
        { "$ref": "#/$defs/developerReference" },
        { "type": "null" }
      ]
    },
    "feeConfiguration": {
      "oneOf": [
        { "$ref": "#/$defs/feeConfiguration" },
        { "type": "null" }
      ]
    },
    "kind": {
      "const": "programmable-launch-router-readiness"
    },
    "manifestSnapshot": {
      "oneOf": [
        { "$ref": "#/$defs/manifestSnapshot" },
        { "type": "null" }
      ]
    },
    "resolvedRouter": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedRouter" },
        { "type": "null" }
      ]
    },
    "route": {
      "oneOf": [
        { "$ref": "#/$defs/route" },
        { "type": "null" }
      ]
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "state": {
      "enum": [
        "not-applicable",
        "analysis-pending",
        "prelaunch-bound"
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "not-applicable" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "applicability": { "$ref": "#/$defs/notApplicableApplicability" },
          "developerReference": { "type": "null" },
          "feeConfiguration": { "type": "null" },
          "manifestSnapshot": { "type": "null" },
          "resolvedRouter": { "type": "null" },
          "route": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "analysis-pending" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "applicability": { "$ref": "#/$defs/pendingApplicability" },
          "developerReference": { "type": "null" },
          "feeConfiguration": { "type": "null" },
          "manifestSnapshot": { "type": "null" },
          "resolvedRouter": { "type": "null" },
          "route": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "prelaunch-bound" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "applicability": { "$ref": "#/$defs/prelaunchApplicability" },
          "developerReference": { "$ref": "#/$defs/developerReference" },
          "feeConfiguration": { "$ref": "#/$defs/feeConfiguration" },
          "manifestSnapshot": { "$ref": "#/$defs/manifestSnapshot" },
          "resolvedRouter": { "$ref": "#/$defs/resolvedRouter" },
          "route": { "$ref": "#/$defs/route" }
        }
      }
    }
  ],
  "$defs": {
    "address": {
      "pattern": "^0x[0-9A-Fa-f]{40}$",
      "type": "string"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteLength",
        "gitBlobOid",
        "path",
        "sha256"
      ],
      "properties": {
        "byteLength": {
          "minimum": 1,
          "maximum": 16777216,
          "type": "integer"
        },
        "gitBlobOid": { "$ref": "#/$defs/objectId" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "base64Bytes": {
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 349528,
      "minLength": 4,
      "type": "string"
    },
    "routeBase64Bytes": {
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "maxLength": 709676,
      "minLength": 4,
      "type": "string"
    },
    "routePayloadCommitment": {
      "type": "object",
